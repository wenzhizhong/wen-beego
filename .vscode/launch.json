{
  // 使用 IntelliSense 了解相关属性。 
  // 悬停以查看现有属性的描述。
  // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Beego App",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/http",
      "env": {
        // "BEEGO_RUNMODE": "dev"
      },
      "args": [
        "-vendor=true",
        // "-runmode=dev"
      ]
    },
    {
      "name": "Local Debug by Attach Name",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processName": "wen-beego.exe"  // Windows
      // "processName": "wen-beego"   // Linux/macOS
    },
    {
      //终端运行 bee dlv -port 8013
      "name": "Bee dlv Debug Beego App",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "remotePath": "${workspaceFolder}/cmd/http",
      "port": 8013,
      "host": "127.0.0.1",
      "showLog": true,
      "trace": "verbose"
    },
    {
      "name": "Debug MQ",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/mq",
      "env": {
        // "BEEGO_RUNMODE": "dev"
      },
      "args": [
        "-vendor=true",
        // "-runmode=dev"
      ]
    }
  ]
}